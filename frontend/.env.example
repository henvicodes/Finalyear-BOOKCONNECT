# Optional. Where the API lives. Leave this out normally:
#  - during development the app uses http://localhost:5000
#  - in production the backend serves the website itself, so the app uses its own address
# Only set it if the API is hosted at a DIFFERENT address than the website.
# VITE_API_URL=https://api.example.com

# The deployed ManuscriptRegistry smart contract address on Sepolia testnet
# (see /blockchain). Required for the real on-chain "Register on Sepolia"
# button in the Author Dashboard's Blockchain tab — without it, that
# feature is hidden but everything else works fine.
VITE_CONTRACT_ADDRESS=

# The deployed PaymentLedger smart contract address on Sepolia testnet
# (see /blockchain). Required for wallet P2P transfers to move real ETH
# on-chain when the recipient has a linked wallet — without it, transfers
# fall back to off-chain-only platform transfers.
VITE_PAYMENT_LEDGER_ADDRESS=
