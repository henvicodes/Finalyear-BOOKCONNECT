# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string.
# Local dev:  mongodb://localhost:27017/bookConnect
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookConnect
MONGO_URI=mongodb://localhost:27017/bookConnect

# Port the Express API listens on.
PORT=5000

# Origin of the frontend dev server — used for CORS and Socket.io.
CLIENT_URL=http://localhost:5173

# Secret used to sign JWTs. Use a long, random string in production
# (e.g. `openssl rand -hex 32`) — never reuse this across environments.
JWT_SECRET=change-this-to-a-long-random-string
# Optional — how long issued tokens stay valid. Defaults to 30d if unset.
JWT_EXPIRE=30d

# Gmail account used to send OTP verification emails via Nodemailer.
# EMAIL_PASS must be a 16-character Gmail "App Password", not your normal
# account password — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google account).
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-char-app-password

# Optional. Primary translation provider — get a key at
# https://console.anthropic.com/settings/keys. If unset, translation falls
# back to Gemini (below), then to the free MyMemory API, which has a
# shared daily quota that can run out under heavy testing.
CLAUDE_API_KEY=

# Optional. Powers AI writing assistance and the AI chatbot always, and
# translation as a fallback if CLAUDE_API_KEY isn't set. Get a free key at
# https://aistudio.google.com/apikey. If unset, writing assistance falls
# back to rule-based/offline behavior.
GEMINI_API_KEY=

NODE_ENV=development
