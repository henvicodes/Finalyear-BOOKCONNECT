# Copy this to .env in this same folder and fill in real values.
# NEVER commit .env, never paste its contents anywhere (chat, issues, etc).

# The Sepolia RPC URL you got from Alchemy/Infura/Google Cloud Blockchain RPC.
SEPOLIA_RPC_URL=

# Your MetaMask account's private key (Account details > Show private key
# in MetaMask). Use a wallet you created for testnet use — never export the
# key of a wallet that holds real funds, even though this is testnet-only.
SEPOLIA_PRIVATE_KEY=
